# Copy to secrets.yaml in your ESPHome config directory and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
wifi_ap_password: "fallback-ap-password"   # at least 8 characters
# Generate with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
